message_file=$1

if grep -Eiq '^Co-Authored-By:[[:space:]].*(noreply@anthropic\.com|@anthropic\.com|noreply@openai\.com|@openai\.com|Claude (Sonnet|Opus|Haiku|Code)|ChatGPT|OpenAI Codex|GitHub Copilot)' "$message_file"; then
